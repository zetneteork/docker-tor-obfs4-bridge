#!/usr/bin/env bash
# get-bridge-line – Extract the obfs4 bridge line from Tor's log and PT state.
#
# This script works around the lack of a dedicated bridge-line output in Tor;
# see: https://gitlab.torproject.org/tpo/core/tor/-/issues/29128
#
# Usage: get-bridge-line
# Output: obfs4 <IP>:<port> <fingerprint> cert=<...> iat-mode=<...>
set -euo pipefail

# Allow paths to be overridden for testing.
TOR_LOG="${TOR_LOG_PATH:-/var/log/tor/log}"
PT_STATE="${PT_STATE_PATH:-/var/lib/tor/pt_state/obfs4_bridgeline.txt}"

# ---------------------------------------------------------------------------
# Verify readable inputs
# ---------------------------------------------------------------------------
if [[ ! -r "${TOR_LOG}" ]]; then
    printf 'get-bridge-line: cannot read Tor log file %s\n' "${TOR_LOG}" >&2
    exit 1
fi

if [[ ! -r "${PT_STATE}" ]]; then
    printf 'get-bridge-line: cannot read PT state file %s\n' "${PT_STATE}" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Extract fields
# ---------------------------------------------------------------------------

# Public IP address – prefer the "changed" message, fall back to "suggested".
addr=$(grep 'Our IP Address has changed from' "${TOR_LOG}" \
    | sed 's/.* \([0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\); .*/\1/' \
    | tail -1 || true)

if [[ -z "${addr}" ]]; then
    addr=$(grep 'External address seen and suggested by a directory authority:' "${TOR_LOG}" \
        | sed 's/.*: \([0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\)/\1/' \
        | tail -1 || true)
fi

# obfs4 port.
port=$(grep "Registered server transport 'obfs4' at" "${TOR_LOG}" \
    | sed "s/.*:\([0-9]\{1,5\}\)'$/\1/" \
    | tail -1 || true)

# Identity fingerprint.
fingerprint=$(grep "Your Tor server's identity key fingerprint is" "${TOR_LOG}" \
    | sed "s/.*'\([0-9A-F]\{40\}\)'$/\1/" \
    | tail -1 || true)

# obfs4 cert + iat-mode arguments from the PT state file.
obfs4_args=$(grep '^Bridge obfs4' "${PT_STATE}" \
    | sed 's/.*\(cert=.*\)/\1/' \
    | tail -1 || true)

# ---------------------------------------------------------------------------
# Validate all fields were found
# ---------------------------------------------------------------------------
if [[ -z "${addr}" || -z "${port}" || -z "${fingerprint}" || -z "${obfs4_args}" ]]; then
    printf 'get-bridge-line: could not assemble bridge line – one or more fields missing.\n' >&2
    printf '  addr=%s  port=%s  fingerprint=%s  obfs4_args=%s\n' \
        "${addr:-MISSING}" "${port:-MISSING}" \
        "${fingerprint:-MISSING}" "${obfs4_args:-MISSING}" >&2
    printf 'Tor'\''s log format may have changed. This is a bug.\n' >&2
    exit 1
fi

printf 'obfs4 %s:%s %s %s\n' "${addr}" "${port}" "${fingerprint}" "${obfs4_args}"
